FROM golang:1.27-trixie as builder

ARG GOPROXY=
ARG HTTP_PROXY=
ARG HTTPS_PROXY=

RUN apt-get update && apt-get install -y \
    gcc \
    ca-certificates

RUN go install github.com/vektra/mockery/v3@v3.9.0
RUN go install github.com/swaggo/swag/cmd/swag@v1.16.6

WORKDIR /app

# Cache Go module downloads in a separate layer (only re-runs when go.mod/go.sum change)
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

# Now copy the rest of the source
COPY . /app
ENV GOBIN=/app/bin

ARG TAG=
ARG SHA=

# Generate mocks and swagger (use build cache to speed up swag)
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    make mock
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    make swag

# Build the server. `build` is `build-server`: the framework, the API and every
# plugin in the generated registry link into this one binary. No .so files are
# produced for the release image.
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    VERSION=${TAG}@${SHA} make build

FROM debian:trixie-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    # gitextractor shells out to the git CLI, so the binary must be present or
    # every clone fails with "git: executable file not found in $PATH".
    # debian:trixie-slim does not ship it; the official image inherits it from
    # its python base.
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/bin/lake ./bin/lake

# Empty mount point for sideloaded plugins
RUN mkdir -p bin/plugins

# Create empty python plugins dir to avoid startup error
RUN mkdir -p python/plugins

ENV PORT=8080
EXPOSE 8080

CMD ["./bin/lake"]
