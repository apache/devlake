          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 'Severity' AS metric, ROUND(CAST(SUM(CASE WHEN f.severity = 'high' AND f.resolution_status = 'resolved' THEN 1 ELSE 0 END) * 100.0 AS NUMERIC) / NULLIF(SUM(CASE WHEN f.severity = 'high' AND f.resolution_status IN ('resolved', 'unresolved') THEN 1 ELSE 0 END), 0), 1) AS high, ROUND(CAST(SUM(CASE WHEN f.severity = 'medium' AND f.resolution_status = 'resolved' THEN 1 ELSE 0 END) * 100.0 AS NUMERIC) / NULLIF(SUM(CASE WHEN f.severity = 'medium' AND f.resolution_status IN ('resolved', 'unresolved') THEN 1 ELSE 0 END), 0), 1) AS medium, ROUND(CAST(SUM(CASE WHEN f.severity = 'low' AND f.resolution_status = 'resolved' THEN 1 ELSE 0 END) * 100.0 AS NUMERIC) / NULLIF(SUM(CASE WHEN f.severity = 'low' AND f.resolution_status IN ('resolved', 'unresolved') THEN 1 ELSE 0 END), 0), 1) AS low FROM _tool_cursor_bugbot_reviews AS r JOIN _tool_cursor_bugbot_findings AS f ON r.connection_id = f.connection_id AND r.scope_id = f.scope_id AND r.request_id = f.request_id WHERE $__timeFilter(r.timestamp) AND ('${connection_id}' = '' OR r.connection_id::text = '${connection_id}') AND r.scope_id = '${scope_id}'",
