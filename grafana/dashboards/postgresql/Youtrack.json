      "targets": [
        {
          "datasource": "postgresql",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH _created AS (SELECT COUNT(DISTINCT i.id) AS cnt FROM issues AS i JOIN board_issues AS bi ON i.id = bi.issue_id WHERE COALESCE(NULLIF(i.type, ''), '(no type)') IN (${type}) AND $__timeFilter(i.created_date) AND ('${board_id:csv}' = '' OR bi.board_id::text = ANY(ARRAY[${board_id:singlequote}]::text[]))), _resolved AS (SELECT COUNT(DISTINCT i.id) AS cnt FROM issues AS i JOIN board_issues AS bi ON i.id = bi.issue_id WHERE COALESCE(NULLIF(i.type, ''), '(no type)') IN (${type}) AND i.status = 'DONE' AND $__timeFilter(i.resolution_date) AND ('${board_id:csv}' = '' OR bi.board_id::text = ANY(ARRAY[${board_id:singlequote}]::text[]))) SELECT CASE WHEN _created.cnt = '0' THEN NULL ELSE CAST(1.0 * _resolved.cnt AS NUMERIC) / NULLIF(_created.cnt, 0) END AS value FROM _created, _resolved",
