        {
          "datasource": "postgresql",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH _created AS (SELECT CAST(EXTRACT(YEAR FROM i.created_date) || '-' || EXTRACT(MONTH FROM i.created_date) || '-01' AS DATE) AS time, COUNT(DISTINCT i.id) AS cnt FROM issues AS i JOIN board_issues AS bi ON i.id = bi.issue_id WHERE COALESCE(NULLIF(i.type, ''), '(no type)') IN (${type}) AND $__timeFilter(i.created_date) AND ('${board_id:csv}' = '' OR bi.board_id::text = ANY(ARRAY[${board_id:singlequote}]::text[])) GROUP BY 1), _resolved AS (SELECT CAST(EXTRACT(YEAR FROM i.resolution_date) || '-' || EXTRACT(MONTH FROM i.resolution_date) || '-01' AS DATE) AS time, COUNT(DISTINCT i.id) AS cnt FROM issues AS i JOIN board_issues AS bi ON i.id = bi.issue_id WHERE COALESCE(NULLIF(i.type, ''), '(no type)') IN (${type}) AND i.status = 'DONE' AND $__timeFilter(i.resolution_date) AND ('${board_id:csv}' = '' OR bi.board_id::text = ANY(ARRAY[${board_id:singlequote}]::text[])) GROUP BY 1), _union AS (SELECT time, cnt AS created, 0 AS resolved FROM _created UNION ALL SELECT time, 0 AS created, cnt AS resolved FROM _resolved) SELECT time, SUM(created) AS \"Created\", SUM(resolved) AS \"Resolved\" FROM _union GROUP BY time ORDER BY time NULLS FIRST",
          "refId": "A"
        }
      ],
      "title": "Created vs Resolved over Time",
      "type": "timeseries"
    },
