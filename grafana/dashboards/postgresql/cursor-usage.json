        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "devlake-postgres-api"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CAST(event_time AS DATE) AS time, CAST(SUM(CASE WHEN kind = 'Usage-based' THEN charged_cents ELSE 0 END) AS NUMERIC) / NULLIF(100, 0) AS \"On-Demand\", CAST(SUM(CASE WHEN kind = 'Included in Business' THEN charged_cents ELSE 0 END) AS NUMERIC) / NULLIF(100, 0) AS \"Included\" FROM _tool_cursor_usage_events WHERE $__timeFilter(event_time) AND ('${connection_id}' = '' OR connection_id::text = '${connection_id}') AND scope_id = '${scope_id}' GROUP BY CAST(event_time AS DATE) ORDER BY 1 NULLS FIRST",
          "refId": "A"
        }
      ],
      "title": "Daily Spend (On-Demand + Included)",
      "type": "timeseries"
