          "rawSql": "SELECT model AS \"Model\", CAST(CAST(SUM(total_cents) AS NUMERIC) / NULLIF(COUNT(*), 0) AS NUMERIC) / NULLIF(100, 0) AS \"Avg Cost\", CAST(SUM(charged_cents) AS NUMERIC) / NULLIF(100, 0) AS \"Charged\", COUNT(*) AS \"Events\", CAST(COUNT(*) * 100.0 AS NUMERIC) / NULLIF(SUM(COUNT(*)) OVER (), 0) AS \"Usage %\" FROM _tool_cursor_usage_events WHERE $__timeFilter(event_time) AND ('${connection_id}' = '' OR connection_id::text = '${connection_id}') AND scope_id = '${scope_id}' GROUP BY \"model\" ORDER BY SUM(charged_cents) DESC NULLS LAST",
