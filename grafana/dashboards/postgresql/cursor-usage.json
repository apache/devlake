          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CAST((COALESCE((SELECT SUM(spend_cents + included_spend_cents) FROM _tool_cursor_user_spend WHERE ('${connection_id}' = '' OR connection_id::text = '${connection_id}') AND scope_id = '${scope_id}'), 0) - COALESCE((SELECT SUM(charged_cents) FROM _tool_cursor_usage_events WHERE ('${connection_id}' = '' OR connection_id::text = '${connection_id}') AND scope_id = '${scope_id}' AND event_time >= (SELECT MIN(billing_cycle_start) FROM _tool_cursor_user_spend WHERE ('${connection_id}' = '' OR connection_id::text = '${connection_id}') AND scope_id = '${scope_id}')), 0)) AS NUMERIC) / NULLIF(100, 0) AS \"Reconciliation Delta\"",
          "refId": "A"
        }
      ],
      "title": "Reconciliation Delta",
      "type": "stat"
