          "rawQuery": true,
          "rawSql": "select \n  date(cl.created_date) as time,\n  cl.to_value as metric,\n  count(*) as value\nfrom issue_changelogs cl\n  join issues i on cl.issue_id = i.id\n  join board_issues bi on i.id = bi.issue_id\n  join _tool_youtrack_projects p on bi.board_id = concat('youtrack:YoutrackProject:', p.connection_id, ':', p.id)\n  left join _tool_youtrack_scope_configs sc on sc.id = p.scope_config_id and sc.connection_id = p.connection_id\nwhere \n  cl.field_name = coalesce(nullif(sc.state_field, ''), 'State')\n  and cl.to_value in ('TODO', 'IN_PROGRESS', 'DONE', 'OTHER')\n  and coalesce(nullif(i.type, ''), '(no type)') in (${type})\n  and $__timeFilter(cl.created_date)\n  and bi.board_id in (${board_id})\ngroup by 1, 2\norder by 1",
