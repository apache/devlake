        {
          "datasource": "mysql",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "with _created as(\n  select\n    count(distinct i.id) as cnt\n  from issues i\n    join board_issues bi on i.id = bi.issue_id\n  where \n    coalesce(nullif(i.type, ''), '(no type)') in (${type})\n    and $__timeFilter(i.created_date)\n    and bi.board_id in (${board_id})\n),\n_resolved as(\n  select\n    count(distinct i.id) as cnt\n  from issues i\n    join board_issues bi on i.id = bi.issue_id\n  where \n    coalesce(nullif(i.type, ''), '(no type)') in (${type})\n    and i.status = 'DONE'\n    and $__timeFilter(i.resolution_date)\n    and bi.board_id in (${board_id})\n)\n\nselect \n  case when _created.cnt = 0 then null else 1.0 * _resolved.cnt / _created.cnt end as value\nfrom _created, _resolved",
