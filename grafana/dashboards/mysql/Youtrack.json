          "format": "time_series",
          "rawQuery": true,
          "rawSql": "with _ranks as(\n  select \n    round(i.lead_time_minutes/1440.0) as lead_time_day\n  from issues i\n    join board_issues bi on i.id = bi.issue_id\n  where \n    coalesce(nullif(i.type, ''), '(no type)') in (${type})\n    and i.status = 'DONE'\n    and $__timeFilter(i.resolution_date)\n    and bi.board_id in (${board_id})\n)\n\nselect \n  now() as time,\n  lpad(concat(lead_time_day, 'd'), 4, ' ') as metric,\n  percent_rank() over (order by lead_time_day asc) as value\nfrom _ranks\norder by lead_time_day asc",
          "refId": "A"
        }
      ],
