        {
          "datasource": "mysql",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "with _created as(\n  select\n    date(concat(extract(year from i.created_date), '-', extract(month from i.created_date), '-01')) as time,\n    count(distinct i.id) as cnt\n  from issues i\n    join board_issues bi on i.id = bi.issue_id\n  where \n    coalesce(nullif(i.type, ''), '(no type)') in (${type})\n    and $__timeFilter(i.created_date)\n    and bi.board_id in (${board_id})\n  group by 1\n),\n_resolved as(\n  select\n    date(concat(extract(year from i.resolution_date), '-', extract(month from i.resolution_date), '-01')) as time,\n    count(distinct i.id) as cnt\n  from issues i\n    join board_issues bi on i.id = bi.issue_id\n  where \n    coalesce(nullif(i.type, ''), '(no type)') in (${type})\n    and i.status = 'DONE'\n    and $__timeFilter(i.resolution_date)\n    and bi.board_id in (${board_id})\n  group by 1\n),\n_union as(\n  select time, cnt as created, 0 as resolved from _created\n  union all\n  select time, 0 as created, cnt as resolved from _resolved\n)\n\nselect\n  time,\n  sum(created) as \"Created\",\n  sum(resolved) as \"Resolved\"\nfrom _union\ngroup by time\norder by time",
          "refId": "A"
        }
      ],
      "title": "Created vs Resolved over Time",
      "type": "timeseries"
    },
