# UBI 9-based DevLake config-ui image (parity with Dockerfile).

# Pin to multi-arch manifest digest (not :latest) for reproducible builds.
FROM registry.access.redhat.com/ubi9/nodejs-18@sha256:ffbad8210aee178157e7621b5fa43fb85f1ac205246b0d2606bea778549da8c1 AS builder

USER 0
WORKDIR /opt/app-root/src

COPY . .

# Use committed Yarn Berry binary (.yarn/releases/yarn-3.4.1.cjs via yarnPath)
RUN node .yarn/releases/yarn-3.4.1.cjs install && \
    node .yarn/releases/yarn-3.4.1.cjs build

FROM registry.access.redhat.com/ubi9/ubi-minimal@sha256:57c8151c51445a07e503dab9dc9211dc3cdeac9d45ed81a10954b7d770659b3b

USER 0

RUN microdnf -y update && \
    microdnf -y install \
        nginx \
        httpd-tools \
        iproute \
        gettext \
        shadow-utils \
        findutils \
        tar \
        coreutils-single && \
    microdnf clean all && \
    rm -rf /var/cache/yum /var/cache/dnf

# Unprivileged nginx: drop user directive, write pid under /tmp,
# and remove the packaged server block that binds privileged port 80.
RUN sed -i '/^user /d' /etc/nginx/nginx.conf && \
    sed -i 's|pid\s\+/run/nginx.pid;|pid /tmp/nginx.pid;|' /etc/nginx/nginx.conf && \
    sed -i 's|pid\s\+/var/run/nginx.pid;|pid /tmp/nginx.pid;|' /etc/nginx/nginx.conf && \
    awk 'BEGIN{skip=0} /^[[:space:]]*server[[:space:]]*\{/{if(!done++){skip=1}} skip{if(/\{/) depth++; if(/\}/){depth--; if(depth==0){skip=0; next}} next} {print}' \
        /etc/nginx/nginx.conf > /tmp/nginx.conf && \
    mv /tmp/nginx.conf /etc/nginx/nginx.conf && \
    rm -f /etc/nginx/conf.d/default.conf

COPY ./nginx.conf /etc/nginx/conf.d/default.conf.tpl
COPY --from=builder /opt/app-root/src/dist/ /usr/share/nginx/html/
COPY --from=builder /opt/app-root/src/nginx.sh /usr/bin/nginx.sh
RUN chmod +x /usr/bin/nginx.sh && \
    mkdir -p /var/log/nginx /var/lib/nginx/tmp /run && \
    chgrp -R 0 /etc/nginx /var/log/nginx /var/lib/nginx /usr/share/nginx /run /tmp && \
    chmod -R g=u /etc/nginx /var/log/nginx /var/lib/nginx /usr/share/nginx /run /tmp

EXPOSE 4000 4443

USER 101
CMD ["/usr/bin/nginx.sh"]
